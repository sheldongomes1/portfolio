# skillgate.yaml: copy this file into your project as skillgate.yaml and edit it.
# All paths are relative to this file. API keys never go here: set ANTHROPIC_API_KEY
# (and GEMINI_API_KEY for `run --mode api`) in your environment or an uncommitted .env.

skill:
  name: invoice-review              # used in receipts; defaults to the skill file's folder name
  path: skill/skill.md              # .md, .txt, or a .docx export of the Google Doc
  references:                       # reference files the skill uses (globs allowed)
    - skill/reference/*.md

paths:
  cases: golden/cases               # one YAML file per golden case
  golden: golden/golden.yaml        # how dev/holdout splits were drawn (seeds)
  criteria: golden/criteria.yaml    # ratified general criteria
  runs: runs                        # one time-stamped directory per run; never overwritten
  receipts: receipts
  reports: reports                  # lint reports
  calibration: calibration          # judge calibration records
  cache: .skillgate/cache           # executor output cache (keep it out of git)

# The judge. Exact model IDs only: floating aliases such as "-latest" are rejected,
# because a receipt must name the model version that judged.
judge:
  provider: anthropic
  model: claude-opus-5
  settings:
    effort: high                    # recorded in every receipt
    max_tokens: 16000
  max_retries: 4                    # API errors are retried with exponential backoff, then ERROR
  timeout_seconds: 120
  concurrency: 4

# The executor, used by `run --mode api`. Manual mode does not call it. Pick the exact Gemini
# model version from Google's model list; aliases ending in -latest are rejected. Before any paid
# call, Skill Gate asks the Gemini API for this model and stops if it does not exist. Every
# setting here is passed to the model and recorded in the receipt.
# executor:
#   provider: gemini
#   model: <exact Gemini model version>
#   settings: {temperature: 1.0, max_output_tokens: 4000}
#   max_retries: 4
#   concurrency: 4

repeats: 3                          # k: each case runs k times; a case passes only if all k pass

thresholds:
  min_cases_warn: 12                # warn below this many golden cases
  min_cases_verified: 10            # never VERIFIED below this many
  edge_share: 0.30                  # share of cases tagged edge or should_not_flag
  holdout_share: 0.30               # share of cases drawn into the holdout split
  calibration_agreement: 0.90       # judge-human agreement required, overall and on FAIL verdicts
  calibration_min_sample: 30

budget:
  max_usd: 10.00                    # `run --mode api` and `judge` stop above this unless --confirm-budget

# Assumptions for `skillgate estimate` (tokens are counted offline from characters).
estimate:
  chars_per_token: 4
  executor_output_tokens: 2000      # per executor call, answer plus thinking
  judge_output_tokens: 1500         # per judge call, thinking plus the verdict
  margin: 1.25                      # multiplier on the total

# Prices per million tokens, used by `estimate` and the cost logs. A model with no price here
# cannot be estimated, so paid steps refuse to start. Check each provider's pricing page.
pricing:
  claude-opus-5: {input_per_mtok: 5.00, output_per_mtok: 25.00}
  # <exact Gemini model version>: {input_per_mtok: ..., output_per_mtok: ...}
