# Copy this file to .env (git-ignored) and paste your keys after the = signs.
# Never commit .env, and never paste keys into a chat.
#
# Skill Gate reads .env from the folder you run it in, or the nearest parent folder up to the
# repository root. A variable already set in your shell takes precedence over this file.

# Judge and lint (Anthropic): https://console.anthropic.com/
ANTHROPIC_API_KEY=

# API-mode runs (Gemini): https://aistudio.google.com/apikey
# Google's pricing page says free-tier requests are used to improve Google's products and
# paid-tier requests are not. Use a paid-tier key for anything that is not fictional.
GEMINI_API_KEY=
